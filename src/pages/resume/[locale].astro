---
import '@fontsource-variable/vazirmatn';
import '@fontsource-variable/manrope';
import { content, site, skills, projects, workflow, type Locale } from '../../data/site';
export function getStaticPaths() { return [{ params: { locale: 'fa' } }, { params: { locale: 'en' } }]; }
const locale = Astro.params.locale as Locale;
const fa = locale === 'fa';
const c = content[locale];
const t = (f: string, e: string) => fa ? f : e;
---
<!doctype html>
<html lang={c.lang} dir={c.direction}>
<head><meta charset="UTF-8" /><meta name="robots" content="noindex, follow" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{c.name} - {t('رزومهٔ توسعه‌دهنده فول‌استک', 'Full-Stack Developer Résumé')}</title></head>
<body><article class="sheet">
  <header class="cv-header"><div><p class="cv-eyebrow">FULL-STACK DEVELOPER / FREELANCER</p><h1>{c.name}<span>.</span></h1><p class="legal">{t('نام شناسنامه‌ای: محمد کاظمی', 'Legal name: Mohammad Kazemi')}</p></div><img src="/images/professional-headshot.webp" width="100" height="112" alt={c.name} /></header>
  <div class="cv-columns">
    <aside>
      <section><h2>{t('در یک نگاه', 'AT A GLANCE')}</h2><strong class="experience">{t('۶ سال تجربه', '6 years of experience')}</strong><p>{t('طراحی و توسعهٔ کامل ۶ پروژه', 'Complete design and development of 6 projects')}</p><p>{t('کرمان، ایران | همکاری از راه دور با سراسر جهان', 'Kerman, Iran | Remote collaboration worldwide')}</p></section>
      <section><h2>{t('مهارت‌های فنی', 'TECHNICAL SKILLS')}</h2><div class="cv-skills" dir="ltr">{skills.map(skill => <span>{skill}</span>)}</div></section>
      <section><h2>{t('تحصیلات', 'EDUCATION')}</h2>{c.education.map(item => <div class="degree"><h3>{item.degree}</h3><p>{item.university}</p></div>)}</section>
      <section class="contacts"><h2>{t('ارتباط', 'CONTACT')}</h2><p><a href={site.origin} dir="ltr">homayonkazemi.ir</a></p><p><a href={`mailto:${site.email}`} dir="ltr">{site.email}</a></p><p><a href={site.whatsapp} dir="ltr">{site.internationalPhone}</a><small>{t('پیام در واتساپ و تلگرام', 'Messages via WhatsApp & Telegram')}</small></p><p class="contact-channels"><a href={site.whatsapp}>WhatsApp ↗</a><a href={site.telegram}>Telegram ↗</a></p><p><a href={site.github}>GitHub ↗</a><small dir="ltr">homayonkazemi7897-beep</small></p></section>
    </aside>
    <main>
      <section><h2>{t('معرفی حرفه‌ای', 'PROFESSIONAL PROFILE')}</h2><p class="profile">{t('توسعه‌دهندهٔ فول‌استک و فریلنسر با ۶ سال تجربه در برنامه‌نویسی. در طراحی سایت، توسعهٔ وردپرس و افزونه، ساخت وب‌اپلیکیشن و اتصال API فعالیت می‌کنم و با Node.js، React، Django و PHP کار می‌کنم. پروژه‌های داخل ایران و بین‌المللی را می‌پذیرم. Jornilo و رشدیار متعلق به خودم هستند و طراحی، توسعه و اجرای کامل آن‌ها را شخصاً انجام داده‌ام.', 'Freelance full-stack developer with six years of programming experience. I work on website development, WordPress and plugins, web applications and API integrations using Node.js, React, Django and PHP. I accept projects in Iran and internationally. Jornilo and Roshdyar are my own projects; I independently handled their complete design, development and launch.')}</p></section>
      <section><h2>{t('نمونه‌کارها', 'PROJECT PORTFOLIO')}</h2><p class="section-note">{t('طراحی و توسعهٔ کامل هر شش پروژه توسط خودم انجام شده است.', 'I independently handled the complete design and development of all six projects.')}</p><div class="cv-projects">{projects.map(p => <div class="cv-project"><h3><a href={p.url} dir="ltr">{p.domain} ↗</a></h3><p>{p.note[locale] || c.projectRole}</p></div>)}</div></section>
      <section><h2>{t('مسیر حرفه‌ای', 'MY PATH')}</h2><p>{t('آشنایی با برنامه‌نویسی PLC در مسیر مهندسی برق قدرت، نقطهٔ شروع علاقه‌ام به برنامه‌نویسی بود. تحصیل در روان‌شناسی را برای علاقهٔ شخصی و خودشناسی دنبال کردم. ایدهٔ رشدیار از پیوند این علاقه با توسعهٔ وب و تست‌های آنلاین روان‌شناسی شکل گرفت.', 'PLC programming during my electrical engineering studies sparked my interest in programming. I later studied psychology out of a personal interest in self-discovery. Roshdyar grew from the connection between that interest and developing online psychological tests.')}</p></section>
      <section><h2>{t('شیوهٔ همکاری', 'HOW I WORK')}</h2><ol class="cv-process">{workflow[locale].map((step, i) => <li><span>0{i + 1}</span><strong>{step.title}</strong></li>)}</ol><p class="process-note">{t('دامنهٔ کار، زمان، هزینه، پرداخت‌ها و شرایط پشتیبانی پیش از شروع پروژه توافق می‌شوند. نسخه‌های مرحله‌ای برای دریافت بازخورد ارائه می‌شوند و تحویل شامل کد، دسترسی‌ها و راهنمای لازم است.', 'Scope, timeline, cost, payments and support terms are agreed before starting. Reviewable versions are shared at milestones; handover includes code, access and relevant guidance.')}</p></section>
    </main>
  </div>
  <footer><span>{t('همایون کاظمی | توسعه‌دهندهٔ فول‌استک', 'Homayoun Kazemi | Full-Stack Developer')}</span><a href={site.origin} dir="ltr">homayonkazemi.ir</a></footer>
</article></body>
</html>
<style is:global>


@page{size:A4;margin:0}*{box-sizing:border-box}html{font-family:'Vazirmatn Variable',sans-serif;color:#192c37;background:#e8e7e2;font-synthesis:none}body{margin:0}a{color:inherit;text-decoration:none}h1,h2,h3,p{margin:0}.sheet{width:210mm;height:296mm;position:relative;background:white;margin:auto;padding:15mm 16mm 17mm;overflow:hidden;border-top:2mm solid #d9512c}.cv-header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #d8ddda;padding-bottom:7mm;margin-bottom:7mm;gap:8mm}.cv-eyebrow{font:600 8.5px 'Manrope Variable',sans-serif;letter-spacing:1.7px;color:#d9512c;margin-bottom:2mm;direction:ltr}.cv-header h1{font-size:37px;font-weight:800;line-height:1.5;letter-spacing:-1px}.cv-header h1 span{color:#d9512c}.legal{font-size:11px;color:#62716f;margin-top:1mm}.cv-header img{object-fit:cover;object-position:center 30%;border-radius:9px;flex-shrink:0}.cv-columns{display:grid;grid-template-columns:58mm 1fr;gap:9mm}.cv-columns aside{padding-inline-end:7mm;border-inline-end:1px solid #d8ddda}section{margin-bottom:6mm}h2{font-size:12px;font-weight:700;color:#d9512c;margin-bottom:3mm}p{font-size:11.5px;line-height:1.95;color:#445357}h3{font-size:11.5px;font-weight:650;line-height:1.8}.experience{font-size:18px;font-weight:650;display:block;margin-bottom:2mm}.cv-skills{display:flex;flex-wrap:wrap;gap:6px}.cv-skills span{font:600 10px 'Manrope Variable',sans-serif;padding:6px 8px;background:#f1f3f0;border-radius:4px}.degree{margin-bottom:3mm}.degree p{font-size:10px}.contacts p{font-size:10px;line-height:1.85;margin-bottom:2mm;overflow-wrap:anywhere}.contacts small{font-size:9px;display:block;color:#667472}.contact-channels{display:flex;gap:10px;font-family:'Manrope Variable',sans-serif}.contacts a{font-weight:550}.cv-projects{display:grid;grid-template-columns:1fr 1fr;gap:3mm 4mm}.cv-project{border-bottom:1px solid #e7e9e5;padding-bottom:3mm;min-height:15mm}.cv-project h3{font:700 12px 'Manrope Variable',sans-serif;margin-bottom:1.5mm}.cv-project p{font-size:10px;line-height:1.8}.section-note{font-size:10.5px;margin-bottom:3mm}.cv-process{display:grid;grid-template-columns:1fr 1fr;gap:7px 12px;padding:0;margin:0 0 3mm;list-style:none}.cv-process li{font-size:10.5px;display:flex;align-items:center;gap:6px}.cv-process span{font:550 9px 'Manrope Variable',sans-serif;color:#d9512c}.cv-process strong{font-weight:550}.process-note{font-size:10.5px}.sheet footer{position:absolute;bottom:11mm;inset-inline:16mm;border-top:1px solid #d8ddda;padding-top:3mm;display:flex;justify-content:space-between;font-size:9px;color:#667472}.sheet footer a{font-family:'Manrope Variable',sans-serif}html[lang=en]{font-family:'Manrope Variable',sans-serif}html[lang=en] .cv-header h1{font-size:33px;line-height:1.3}html[lang=en] h2{font-size:10px;letter-spacing:.8px}html[lang=en] p{font-size:10.5px;line-height:1.8}html[lang=en] .cv-project p{font-size:9.5px}html[lang=en] .contacts p{font-size:9px}html[lang=en] .degree h3{font-size:10.5px}html[lang=en] .cv-process li{font-size:9.5px}html[lang=en] .process-note{font-size:10px}html[lang=en] .experience{font-size:15px}html[lang=en] .cv-header{padding-bottom:9mm}html[lang=en] .legal{font-size:10px}html[lang=en] .contacts small{font-size:8.5px}@media print{html{background:white}.sheet{margin:0;print-color-adjust:exact;-webkit-print-color-adjust:exact}}
</style>
