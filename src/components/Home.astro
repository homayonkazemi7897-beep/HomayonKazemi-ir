---
import { Image } from 'astro:assets';
import workspace from '../assets/workspace.png';
import portrait from '../assets/portrait.png';
import Icon from './Icon.astro';
import { content, paths, projects, site, skills, workflow, resumePaths, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const fa = locale === 'fa';
const c = content[locale];
const t = (persian: string, english: string) => fa ? persian : english;
const featured = [projects[1], projects[3]];
const others = [projects[0], projects[2], projects[4], projects[5]];
const icons = ['globe', 'code', 'layers', 'link'];
---
<a class="skip-link" href="#main-content">{t('رفتن به محتوای اصلی', 'Skip to content')}</a>
<header class="site-header">
  <div class="container header-inner">
    <a href={paths[locale]} class="brand" aria-label={c.name}>
      <span class="brand-mark" aria-hidden="true">h<span>.</span></span>
      <span class="brand-name">{c.name}<small>INDEPENDENT DEVELOPER</small></span>
    </a>
    <nav class="desktop-nav" aria-label={t('منوی اصلی', 'Main navigation')}>
      <a href="#work">{t('نمونه‌کارها', 'Work')}</a>
      <a href="#services">{t('خدمات', 'Services')}</a>
      <a href="#about">{t('دربارهٔ من', 'About')}</a>
    </nav>
    <div class="header-actions">
      <a class="language-switch" href={paths[fa ? 'en' : 'fa']} lang={fa ? 'en' : 'fa'} hreflang={fa ? 'en' : 'fa'}><Icon name="globe" size={17} />{fa ? 'EN' : 'فا'}</a>
      <a class="header-contact" href="#contact">{t('شروع همکاری', 'Let’s talk')}<Icon size={17} /></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label={t('باز کردن منو', 'Open menu')}><Icon name="menu" /></button>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label={t('منوی موبایل', 'Mobile navigation')} hidden>
    <a href="#work">{t('نمونه‌کارها', 'Work')}</a><a href="#services">{t('خدمات', 'Services')}</a><a href="#about">{t('دربارهٔ من', 'About')}</a><a href="#contact">{t('شروع همکاری', 'Let’s talk')}</a>
  </nav>
</header>
<main id="main-content">
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="eyebrow"><span class="status-dot"></span>{t('برای ایدهٔ بعدی شما آماده‌ام', 'AVAILABLE FOR YOUR NEXT IDEA')}</div>
      <h1 id="hero-title" aria-label={c.name}>{t('همایون', 'Homayoun')} <br /><span>{t('کاظمی', 'Kazemi')}</span><i aria-hidden="true">.</i></h1>
      <p class="hero-role">{t('توسعه‌دهندهٔ فول‌استک', 'Full-stack developer')}<span class="role-line"></span>{t('فریلنسر', 'Freelancer')}</p>
      <p class="hero-description">{t('از اولین جرقهٔ یک ایده تا یک محصول واقعی در وب؛ وب‌سایت و وب‌اپلیکیشن شما را طراحی و توسعه می‌دهم.', 'From the first spark of an idea to a real product on the web. I design and develop websites and web applications for your business.')}</p>
      <div class="hero-actions"><a class="button button-primary" href="#work">{t('کشف نمونه‌کارها', 'Explore my work')}<Icon /></a><a class="text-link" href="#contact">{t('دربارهٔ پروژه‌ات بگو', 'Tell me about your project')}<span aria-hidden="true">←</span></a></div>
      <a class="resume-download" href={resumePaths[locale]} download><Icon name="download" size={18} />{t('دانلود رزومهٔ حرفه‌ای', 'Download my résumé')}<span>PDF · {fa ? 'FA' : 'EN'}</span></a>
      <div class="hero-meta"><span><Icon name="location" size={17} />{t('کرمان، ایران', 'Kerman, Iran')}</span><span class="meta-divider"></span><span>{t('همکاری بدون مرز', 'Working worldwide')}<Icon name="globe" size={17} /></span></div>
    </div>
    <div class="hero-visual">
      <div class="photo-orbit" aria-hidden="true"></div>
      <span class="visual-index" aria-hidden="true">CREATIVE MIND. DEVELOPER AT HEART.</span>
      <div class="hero-image-wrap">
        <Image src={workspace} alt={t('همایون کاظمی، برنامه‌نویس و توسعه‌دهنده وب در فضای کار', 'Homayoun Kazemi, web developer, in his workspace')} widths={[480, 768, 1100]} sizes="(max-width: 700px) 90vw, 44vw" width={720} format="webp" quality={85} loading="eager" fetchpriority="high" class="hero-image" />
        <div class="image-caption"><span class="caption-dot"></span><span>{t('ایده‌ها اینجا به زندگی می‌آیند.', 'Where ideas come to life.')}<small>DESIGN. DEVELOP. DELIVER.</small></span><Icon name="code" size={28} /></div>
      </div>
      <div class="experience-badge"><strong>{t('۶', '6')}<span>+</span></strong><span>{t('سال تجربه در', 'YEARS OF')}<br />{t('برنامه‌نویسی', 'PROGRAMMING')}</span></div>
      <span class="hero-spark" aria-hidden="true">✳</span>
    </div>
  </section>
  <div class="expertise-strip"><div class="container expertise-inner"><span>WEB DEVELOPMENT</span><i>✳</i><span>WORDPRESS</span><i>✳</i><span>WEB APPLICATIONS</span><i>✳</i><span>API INTEGRATION</span></div></div>
  <section class="skills-section container" aria-labelledby="skills-title"><div><p class="section-kicker">FULL-STACK DEVELOPMENT</p><h2 id="skills-title">{t('ابزارهای ساختن.', 'Tools of the trade.')}</h2></div><div class="skill-tags" dir="ltr">{skills.map(skill => <span>{skill}</span>)}</div></section>
  <section class="section work-section container" id="work" aria-labelledby="work-title">
    <div class="section-heading"><div><p class="section-kicker"><span>01 /</span>{t('ایده‌هایی که ساخته‌ام', 'IDEAS I’VE BUILT')}</p><h2 id="work-title">{t('از ایده تا', 'From idea to')} <em>{t('اجرا.', 'reality.')}</em></h2></div><p class="section-summary">{t('شش پروژه، از اولین طرح تا آخرین خط کد؛ طراحی و توسعهٔ کامل توسط من.', 'Six projects, from the first design to the last line of code. Entirely designed and developed by me.')}</p></div>
    <div class="featured-grid">
      {featured.map((p, i) => <article class={`project-feature project-${i}`}>
        <a href={p.url} target="_blank" rel="noopener noreferrer" class="project-art" aria-label={`${c.visitProject}: ${p.domain}`}>
          <span class="art-category">{i === 0 ? 'INTERNATIONAL PROJECT' : 'PSYCHOLOGY MEETS TECHNOLOGY'}</span>
          <div class={`project-emblem emblem-${i}`} aria-hidden="true">{i === 0 ? <><span class="jornilo-orbit"></span><span class="jornilo-letter">j.</span></> : <><span class="petal p1"></span><span class="petal p2"></span><span class="petal p3"></span><span class="petal p4"></span><span class="petal p5"></span></>}</div>
          <span class="art-wordmark" lang={i === 0 ? 'en' : 'fa'}>{i === 0 ? 'jornilo' : 'رشدیار'}<small>{i === 0 ? 'IDEAS WITHOUT BORDERS' : 'از شناخت خود، تا رشد'}</small></span>
          <span class="art-domain" dir="ltr">{p.domain}</span><span class="project-open"><Icon /></span>
        </a>
        <div class="project-info"><div><span class="project-overline">{i === 0 ? t('پروژهٔ شخصی · بین‌المللی', 'MY OWN PROJECT · INTERNATIONAL') : t('پروژهٔ شخصی · تست‌های آنلاین روان‌شناسی', 'MY OWN PROJECT · PSYCHOLOGICAL TESTS')}</span><h3>{i === 0 ? 'Jornilo' : t('رشدیار', 'Roshdyar')}</h3><p>{p.note[locale]}</p></div><span class="project-number">0{i + 1}</span></div>
      </article>)}
    </div>
    <div class="project-list">{others.map((p, i) => <a class="project-row" href={p.url} target="_blank" rel="noopener noreferrer"><span class="row-number">0{i + 3}</span><span class="row-title" dir="ltr">{p.domain}</span><span class="row-role">{c.projectRole}</span><span class="row-arrow"><Icon size={20} /></span></a>)}</div>
    <a class="github-link" href={site.github} target="_blank" rel="noopener noreferrer"><Icon name="code" size={19} />{t('سمت دیگر کارهایم، در گیت‌هاب', 'More of my work, on GitHub')}<Icon size={18} /></a>
  </section>
  <section class="services-section" id="services" aria-labelledby="services-title"><div class="container section">
    <div class="section-heading"><div><p class="section-kicker"><span>02 /</span>{t('چطور می‌توانیم همکاری کنیم؟', 'HOW WE CAN WORK TOGETHER')}</p><h2 id="services-title">{t('ایده از شما،', 'Your idea.')}<br /><em>{t('ساختن با من.', 'My craft.')}</em></h2></div><p class="section-summary">{t('برای ساخت یک وب‌سایت، توسعهٔ امکانات تازه یا تبدیل یک ایده به وب‌اپلیکیشن، می‌توانیم از همین‌جا شروع کنیم.', 'A new website, custom functionality, or an idea ready to become a web application. This is where we can start.')}</p></div>
    <div class="services-grid">{c.services.map((service, i) => <article class="service"><div class="service-top"><Icon name={icons[i]} size={32} /><span>0{i + 1}</span></div><h3>{service.title}</h3><p>{service.text}</p><span class="service-bottom" aria-hidden="true">{['WEB DESIGN & DEVELOPMENT', 'WORDPRESS & PLUGINS', 'WEB APPLICATIONS', 'API INTEGRATION'][i]}</span></article>)}</div>
  </div></section>
  <section class="section about-section container" id="about" aria-labelledby="about-title">
    <div class="about-visual"><div class="portrait-wrap"><Image src={portrait} alt={t('پرترهٔ همایون کاظمی، محمد کاظمی', 'Portrait of Homayoun Kazemi, Mohammad Kazemi')} widths={[320, 600, 840]} sizes="(max-width: 700px) 85vw, 34vw" width={600} format="webp" quality={85} loading="lazy" /></div><div class="portrait-label"><span>{t('همایون کاظمی', 'Homayoun Kazemi')}</span><small>DEVELOPER. BUILDER. CURIOUS MIND.</small></div><div class="portrait-decoration" aria-hidden="true">&lt;/&gt;</div></div>
    <div class="about-copy"><p class="section-kicker"><span>03 /</span>{t('کمی نزدیک‌تر', 'A LITTLE CLOSER')}</p><h2 id="about-title">{t('پشت هر خط کد،', 'Behind the code,')}<br /><em>{t('یک ذهن کنجکاو.', 'a curious mind.')}</em></h2><p class="about-lead">{c.about[0]}</p><p>{t('همه‌چیز از مهندسی برق قدرت و آشنایی با برنامه‌نویسی PLC شروع شد. لذت ساختن و دیدن نتیجهٔ کدها، من را قدم‌به‌قدم به دنیای وب‌سایت و وب‌اپلیکیشن رساند.', 'It started with power electrical engineering and PLC programming. The satisfaction of building things and seeing code come to life gradually brought me to websites and web applications.')}</p><p>{t('بعدتر، برای علاقهٔ شخصی و خودشناسی، روان‌شناسی خواندم و تا کارشناسی ارشد روان‌شناسی بالینی ادامه دادم. رشدیار، نقطهٔ تلاقی این علاقه با برنامه‌نویسی شد.', 'Later, a personal interest in self-discovery led me to study psychology and earn a master’s in clinical psychology. Roshdyar grew from the place where that interest meets programming.')}</p>
<p>{t('Jornilo و رشدیار پروژه‌های خودم هستند. طراحی، توسعه و اجرای کامل هر دو را شخصاً انجام داده‌ام و مالکیت آن‌ها نیز با خودم است.', 'Jornilo and Roshdyar are my own projects. I own both and independently handled their complete design, development and launch.')}</p>
    <div class="about-facts"><div><strong>{t('۶ سال', '6 years')}</strong><span>{t('تجربهٔ برنامه‌نویسی', 'Programming experience')}</span></div><div><strong>{t('۶ پروژه', '6 projects')}</strong><span>{t('طراحی و توسعهٔ کامل', 'Designed and developed')}</span></div><div><strong>{t('بدون مرز', 'Worldwide')}</strong><span>{t('پذیرش پروژه و همکاری', 'Remote collaboration')}</span></div></div>
    <details class="education"><summary>{t('مسیر تحصیلی من', 'My education')}<Icon name="plus" size={18} /></summary><ul>{c.education.map(item => <li><strong>{item.degree}</strong><span>{item.university}</span></li>)}</ul></details></div>
  </section>
  <section class="workflow-section container" id="process" aria-labelledby="process-title"><div class="section-heading"><div><p class="section-kicker"><span>04 /</span>{t('یک مسیر روشن برای همکاری', 'A CLEAR PATH TO WORKING TOGETHER')}</p><h2 id="process-title">{t('از گفتگوی اول،', 'From our first conversation,')} <em>{t('تا تحویل.', 'to handover.')}</em></h2></div><p class="section-summary">{t('توافق روشن، ارتباط مستمر و خروجی قابل بررسی در هر مرحله.', 'Clear agreements, regular communication and reviewable results at each stage.')}</p></div><div class="workflow-grid">{workflow[locale].map((step, i) => <article><span class="step-number">0{i + 1}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div></section>
  <section class="contact-section container" id="contact" aria-labelledby="contact-title"><div class="contact-card"><div class="contact-top"><p class="section-kicker"><span>05 /</span>{t('فصل بعدی را با هم بسازیم', 'LET’S BUILD WHAT’S NEXT')}</p><span class="contact-available"><span class="status-dot"></span>{t('آمادهٔ همکاری', 'AVAILABLE FOR WORK')}</span></div><div class="contact-content"><div><h2 id="contact-title">{t('ایده‌ای در ذهن داری؟', 'Have an idea in mind?')}<br /><em>{t('درباره‌اش حرف بزنیم.', 'Let’s talk about it.')}</em></h2><p>{t('از کرمان، برای هر جای دنیا. یک پیام، شروع یک همکاری تازه.', 'From Kerman, to anywhere in the world. One message can start something new.')}</p></div><a class="contact-orb" href={`mailto:${site.email}`} aria-label={t('ارسال ایمیل به همایون کاظمی', 'Email Homayoun Kazemi')}><Icon size={42} /></a></div><div class="message-links"><a href={site.whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="message" size={19} />{t('پیام در واتساپ', 'Message on WhatsApp')}<Icon size={16} /></a><a href={site.telegram} target="_blank" rel="noopener noreferrer"><Icon name="send" size={19} />{t('پیام در تلگرام', 'Message on Telegram')}<Icon size={16} /></a><span dir="ltr">{site.phone}</span></div><div class="contact-bottom"><a class="email-link" href={`mailto:${site.email}`} dir="ltr">{site.email}</a><button class="copy-email" data-email={site.email} data-copied={t('کپی شد', 'Copied')} data-error={t('لطفاً ایمیل را انتخاب و کپی کنید', 'Please select and copy the email')}><Icon name="copy" size={18} /><span>{t('کپی ایمیل', 'Copy email')}</span></button><span class="copy-status sr-only" role="status"></span></div></div></section>
</main>
<footer class="site-footer container"><a class="footer-name" href={paths[locale]}>{c.name}<span>.</span></a><p>{t('با دقت طراحی شده. با علاقه ساخته شده.', 'Designed with care. Built with curiosity.')}</p><div><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub<Icon size={14} /></a><a href="#main-content">{t('بازگشت به بالا', 'Back to top')} ↑</a></div></footer>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-nav');
  const closeMenu = () => { if (!toggle || !menu) return; toggle.setAttribute('aria-expanded', 'false'); menu.hidden = true; };
  toggle?.addEventListener('click', () => { if (!menu) return; const open = toggle.getAttribute('aria-expanded') === 'true'; toggle.setAttribute('aria-expanded', String(!open)); menu.hidden = open; });
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { closeMenu(); toggle.focus(); } });
  matchMedia('(min-width: 901px)').addEventListener('change', event => { if (event.matches) closeMenu(); });
  const copy = document.querySelector<HTMLButtonElement>('.copy-email');
  copy?.addEventListener('click', async () => { const status = document.querySelector<HTMLElement>('.copy-status'); const label = copy.querySelector('span'); const original = label?.textContent; try { await navigator.clipboard.writeText(copy.dataset.email ?? ''); if (label) label.textContent = copy.dataset.copied ?? 'Copied'; if (status) status.textContent = copy.dataset.copied ?? 'Copied'; setTimeout(() => { if (label) label.textContent = original ?? ''; }, 2400); } catch { if (status) { status.classList.remove('sr-only'); status.textContent = copy.dataset.error ?? ''; } } });
</script>
